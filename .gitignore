# Live mirrors written every 10 s by the snapshot logger (agent screens, rig state, research copies)
/snapshots/
/research-mirror/

# Dashboard runtime state (dismissed alerts, usage readings, evidence checks)
dashboard/state/

# Scratch
/_to_delete/
__pycache__/
*.pyc

# Databases and secrets never belong in the repo
*.db
*.db-wal
*.db-shm
*.env
.env*

# Per-machine agent settings: permission rules name this PC's user and paths. OpenRig installs the plugin.
.claude/settings.local.json
/.claude/
/architects/.claude/settings.json
/architects/.claude/plugins/
.codex/

# Mirror of ~/openrig/jobs (game studio and other jobs), regenerated
/jobs-mirror/

# Kept private: run outputs (pitches, receipts, game ideas) and the owner's personal draft brief
studio/rigs/*/runs/
briefs/research-brief.v0-yours.md

# Model Architect evidence (quotes private run outputs)
models/observations.jsonl
models/metrics.csv
models/preview/

# Per-seat files OpenRig and Claude Code write inside rig folders
**/.claude/settings.local.json
**/.openrig/
# Any seat's Claude settings: their permission rules name this PC's paths (public readiness, 2026-10-15)
**/.claude/

# Live rig specs whose working folder is outside the repo: only the .example.yaml is published
/architects/platform-dev/rig.yaml

# Model Architect files kept private (MA-032): ledger edits quote the private ledger; the Diplomacy review quotes
# game output; these security reviews describe gaps not yet fixed; the archived proposals name a personal path
models/reviews/*-ledger-updates.json
models/reviews/diplomacy-1/
models/reviews/PL-027-recheck.md
models/reviews/platform-dev-sandbox.md
models/reviews/rig-seat-mod-security.md
models/reviews/rig-platform-check-review.md
models/archive/PROPOSALS.md

# Owner's Advisor private notes (tailnet address) and one-off kickoff messages
/ADVISOR-HANDOFF.md
/architects/kickoff/

# Owner's play notes and launch packets name private game ideas
studio/rigs/*/owner-notes*.md
studio/rigs/*/launch/
