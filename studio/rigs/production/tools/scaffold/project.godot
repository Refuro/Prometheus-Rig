; Production scaffold. The tech lead owns everything past this point (docs/architecture.md).
config_version=5

[application]
config/name="__NAME__"
run/main_scene="res://boot/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
Data="*res://core/data.gd"
Text="*res://core/text.gd"
Platform="*res://platform/platform.gd"
DevTools="*res://dev/dev_tools.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[debug]
gdscript/warnings/untyped_declaration=2

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
